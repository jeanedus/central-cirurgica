# Copie para .env e substitua os valores por segredos exclusivos.
# Para POSTGRES_PASSWORD, use apenas letras e números neste ambiente local.
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD

# Segredo de assinatura dos tokens JWT: mínimo de 32 caracteres aleatórios.
AUTH_JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

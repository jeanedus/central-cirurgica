generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  DOCTOR
  STAFF
  BILLING
  VIEWER
}

enum SurgeryStatus {
  REQUESTED
  UNDER_REVIEW
  AUTHORIZED
  SCHEDULED
  PERFORMED
  BILLED
  PARTIALLY_PAID
  PAID
  CANCELLED
  DENIED
}

enum PayerType {
  INSURANCE
  PUBLIC
  PRIVATE
}

enum MaterialAuthorizationStatus {
  PENDING
  AUTHORIZED
  PARTIALLY_AUTHORIZED
  DENIED
}

enum ProcedureCodeSystem {
  TUSS
  SIGTAP
}

enum CodingSystemKey {
  TUSS
  SIGTAP
  CBHPM
  SOCIETY_MANUAL
  OTHER
}

enum CatalogVersionStatus {
  DRAFT
  IMPORTED
  VALIDATED
  SUPERSEDED
  FAILED
}

enum CatalogImportStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum SourceDocumentType {
  OFFICIAL_CATALOG
  SOCIETY_MANUAL
  GUIDELINE
  REGULATION
  OTHER
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique @db.VarChar(254)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  displayName  String?      @map("display_name") @db.VarChar(120)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships  Membership[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(160)
  slug        String       @unique @db.VarChar(80)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships Membership[]
  procedures  Procedure[]
  surgeries   Surgery[]
  materials   SurgeryMaterial[]
  procedureCodes ProcedureCode[]

  @@map("organizations")
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  role           MembershipRole @default(VIEWER)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@map("memberships")
}

model Procedure {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(160)
  specialty      String       @db.VarChar(80)
  technique      String?
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  surgeries      Surgery[]
  codes          ProcedureCode[]

  @@index([organizationId, name])
  @@map("procedures")
}

model Surgery {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  procedureId      String?      @map("procedure_id") @db.Uuid
  procedureSnapshot String      @map("procedure_snapshot") @db.VarChar(200)
  internalReference String?     @map("internal_reference") @db.VarChar(80)
  specialty        String       @db.VarChar(80)
  hospital         String?      @db.VarChar(160)
  payer            PayerType    @default(INSURANCE)
  status           SurgeryStatus @default(REQUESTED)
  requestDate      DateTime?    @map("request_date") @db.Date
  surgeryDate      DateTime?    @map("surgery_date") @db.Date
  expectedRevenue  Decimal      @default(0) @map("expected_revenue") @db.Decimal(12, 2)
  received         Decimal      @default(0) @db.Decimal(12, 2)
  notes            String?
  requestDetails   Json?        @map("request_details")
  suggestedCodes   Json?        @map("suggested_codes")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  procedure        Procedure?   @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  materials        SurgeryMaterial[]

  @@index([organizationId, surgeryDate])
  @@index([organizationId, status])
  @@map("surgeries")
}

model SurgeryMaterial {
  id                  String                     @id @default(uuid()) @db.Uuid
  organizationId      String                     @map("organization_id") @db.Uuid
  surgeryId           String                     @map("surgery_id") @db.Uuid
  category            String                     @default("OPME") @db.VarChar(80)
  description         String                     @db.VarChar(240)
  manufacturer        String?                    @db.VarChar(160)
  supplier            String?                    @db.VarChar(160)
  referenceCode       String?                    @map("reference_code") @db.VarChar(120)
  quantity            Int                        @default(1)
  unitPrice           Decimal                    @default(0) @map("unit_price") @db.Decimal(12, 2)
  authorizationStatus MaterialAuthorizationStatus @default(PENDING) @map("authorization_status")
  notes               String?
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  surgery             Surgery                    @relation(fields: [surgeryId], references: [id], onDelete: Cascade)

  @@index([organizationId, surgeryId])
  @@map("surgery_materials")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(80)
  entity    String   @db.VarChar(80)
  entityId  String   @map("entity_id") @db.VarChar(80)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("audit_logs")
}
model ProcedureCode {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  procedureId    String?            @map("procedure_id") @db.Uuid
  system         ProcedureCodeSystem
  code           String             @db.VarChar(40)
  description    String             @db.VarChar(500)
  notes          String?
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  procedure      Procedure?         @relation(fields: [procedureId], references: [id], onDelete: SetNull)

  @@unique([organizationId, system, code])
  @@index([organizationId, system, description])
  @@index([organizationId, procedureId])
  @@map("procedure_codes")
}


model CodingSystem {
  id          String           @id @default(uuid()) @db.Uuid
  key         CodingSystemKey  @unique
  name        String           @db.VarChar(160)
  authority   String?          @db.VarChar(160)
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  versions    CatalogVersion[]

  @@map("coding_systems")
}

model SourceDocument {
  id            String             @id @default(uuid()) @db.Uuid
  type          SourceDocumentType
  title         String             @db.VarChar(300)
  issuer        String?            @db.VarChar(200)
  edition       String?            @db.VarChar(120)
  publishedAt   DateTime?          @map("published_at") @db.Date
  sourceUrl     String?            @map("source_url") @db.VarChar(1000)
  checksum      String?            @db.VarChar(128)
  pageCount     Int?               @map("page_count")
  metadata      Json?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  catalogVersions CatalogVersion[]
  importBatches CatalogImportBatch[]

  @@index([type, issuer])
  @@map("source_documents")
}

model CatalogVersion {
  id               String                @id @default(uuid()) @db.Uuid
  codingSystemId   String                @map("coding_system_id") @db.Uuid
  sourceDocumentId String?               @map("source_document_id") @db.Uuid
  versionLabel     String                @map("version_label") @db.VarChar(120)
  competence       String?               @db.VarChar(12)
  validFrom        DateTime?             @map("valid_from") @db.Date
  validTo          DateTime?             @map("valid_to") @db.Date
  publishedAt      DateTime?             @map("published_at") @db.Date
  importedAt       DateTime?             @map("imported_at") @db.Timestamptz(6)
  checksum         String?               @db.VarChar(128)
  status           CatalogVersionStatus  @default(DRAFT)
  recordsCount     Int?                  @map("records_count")
  metadata         Json?
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  codingSystem     CodingSystem          @relation(fields: [codingSystemId], references: [id], onDelete: Restrict)
  sourceDocument   SourceDocument?       @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  codes            CatalogCode[]
  importBatches    CatalogImportBatch[]
  datasetRecords   CatalogDatasetRecord[]

  @@unique([codingSystemId, versionLabel])
  @@index([codingSystemId, competence])
  @@index([status, validFrom, validTo])
  @@map("catalog_versions")
}

model CatalogCode {
  id               String         @id @default(uuid()) @db.Uuid
  catalogVersionId String         @map("catalog_version_id") @db.Uuid
  code             String         @db.VarChar(40)
  description      String         @db.VarChar(1000)
  active           Boolean        @default(true)
  attributes       Json?
  rawRecord        Json?          @map("raw_record")
  sourceLine       Int?           @map("source_line")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  catalogVersion  CatalogVersion @relation(fields: [catalogVersionId], references: [id], onDelete: Restrict)

  @@unique([catalogVersionId, code])
  @@index([code])
  @@index([catalogVersionId, description])
  @@map("catalog_codes")
}

model CatalogImportBatch {
  id               String              @id @default(uuid()) @db.Uuid
  catalogVersionId String?             @map("catalog_version_id") @db.Uuid
  sourceDocumentId String?             @map("source_document_id") @db.Uuid
  fileName         String              @map("file_name") @db.VarChar(300)
  checksum         String              @db.VarChar(128)
  status           CatalogImportStatus @default(PENDING)
  totalRecords     Int?                @map("total_records")
  insertedRecords  Int?                @map("inserted_records")
  updatedRecords   Int?                @map("updated_records")
  rejectedRecords  Int?                @map("rejected_records")
  errors           Json?
  startedAt        DateTime?           @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime?           @map("finished_at") @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  catalogVersion   CatalogVersion?     @relation(fields: [catalogVersionId], references: [id], onDelete: SetNull)
  sourceDocument   SourceDocument?     @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([catalogVersionId, createdAt])
  @@index([status, createdAt])
  @@map("catalog_import_batches")
}


model CatalogDatasetRecord {
  id               String         @id @default(uuid()) @db.Uuid
  catalogVersionId String         @map("catalog_version_id") @db.Uuid
  datasetName      String         @map("dataset_name") @db.VarChar(100)
  sourceLine       Int            @map("source_line")
  data             Json
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  catalogVersion   CatalogVersion @relation(fields: [catalogVersionId], references: [id], onDelete: Restrict)

  @@unique([catalogVersionId, datasetName, sourceLine])
  @@index([catalogVersionId, datasetName])
  @@map("catalog_dataset_records")
}
